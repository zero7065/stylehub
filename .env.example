# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional. If present alongside or instead of Gemini key,
# Chat Assistant widget executes fast inference using Llama 3 models on Groq.
GROQ_API_KEY=""

# Node Environment Mode (development | production)
NODE_ENV=production

# Network bind ports (Ingress proxy default)
PORT=3000

# Development server URL for SPA redirect (used in dev mode only)
DEV_SERVER_URL=http://localhost:5173

# Backend API URL (used by Vite dev server for proxy and PWA caching)
BACKEND_URL=http://localhost:3000

# VITE_PAYSTACK_PUBLIC_KEY: Optional custom public Paystack key for payments.
VITE_PAYSTACK_PUBLIC_KEY=""
